rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ----------------------------------------------------
    // 1. Users Collection (/users/{userId})
    // ----------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read their own profile or referral info; admins read all
      allow read: if isAuthenticated();
      
      // User can create their own profile upon registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // User can update their own personal info; admins can update status/slots
      allow update: if isOwner(userId) || isAdmin();
      
      // Admin only delete
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 2. Deposits Collection (/deposits/{depositId})
    // ----------------------------------------------------
    match /deposits/{depositId} {
      // Members read their own deposits; admins read all deposits
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Members create deposits with their own userId
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Admins update/delete deposit statuses (Verified / Rejected)
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 3. Referrals Collection (/referrals/{referralId})
    // ----------------------------------------------------
    match /referrals/{referralId} {
      // Members read referrals where they are referrer; admins read all
      allow read: if isAuthenticated() && 
        (resource.data.referrerId == request.auth.uid || 
         resource.data.referrerCode == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referralCode ||
         isAdmin());
      
      // Authenticated users create referral links
      allow create: if isAuthenticated();
      
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // 4. Audit Logs Collection (/audit_logs/{logId})
    // ----------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are immutable append-only
    }
  }
}
